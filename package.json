{
  "name": "gerritalex.de",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "next dev",
    "import": "node --env-file-if-exists=.env scripts/import-media.ts",
    "build": "npm run import && next build && node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "next analyze",
    "lint": "eslint --fix app components/**/*.{ts,tsx} layouts/**/*.{ts,tsx}",
    "prepare": "husky"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@content-collections/core": "0.15.3",
    "@content-collections/next": "0.2.11",
    "@headlessui/react": "2.2.10",
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "github-slugger": "2.0.0",
    "hast-util-from-html-isomorphic": "2.0.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "postcss": "8.5.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-autolink-headings": "7.1.0",
    "rehype-preset-minify": "7.0.1",
    "rehype-pretty-code": "0.14.6",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.2",
    "unist-util-visit": "5.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "sharp": "0.35.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
